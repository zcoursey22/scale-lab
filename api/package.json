{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Scale Lab target API",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "build": "tsc",
    "test": "echo \"No tests\" && exit 0",
    "start": "node dist/server.js",
    "prepare": "cd .. && husky api/.husky",
    "docker:build": "docker build -t zcoursey22/scale-lab-api:fail .",
    "docker:run": "docker run --rm -p 3000:3000 scale-lab-api"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
